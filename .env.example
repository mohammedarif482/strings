# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL=postgresql://aivo_user:aivo_pass@localhost:5432/aivo_db
POSTGRES_USER=aivo_user
POSTGRES_PASSWORD=aivo_pass
POSTGRES_DB=aivo_db
POSTGRES_PORT=5432

# Redis Cache & Pub/Sub
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# AI & Knowledge Store Credentials
OPENAI_API_KEY=your_openai_key_here

# Backend Service Configuration
JWT_SECRET=super_secret_jwt_key
PORT=4000
NODE_ENV=development

# Cloud Simulator
SIMULATOR_INTERVAL_MINUTES=15

# Admin Web Portal
NEXT_PUBLIC_API_URL=http://localhost:4000
